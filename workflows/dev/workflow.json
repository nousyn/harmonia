{
    "name": "dev",
    "description": "软件开发流程",
    "version": "2.0.0",
    "author": "harmonia",
    "coordinator": "coordinator",
    "root": {
        "type": "sequence",
        "id": "main",
        "children": [
            {
                "type": "task",
                "id": "clarify",
                "role": "coordinator",
                "beforeDispatch": {
                    "inject": ["进入需求澄清阶段。请与用户沟通，理解需求意图、功能范围和约束条件，然后产出 prd（需求文档）。"]
                },
                "afterComplete": {
                    "inject": ["需求澄清完成。请检查 prd 是否已写入并提交用户审批。"]
                }
            },
            {
                "type": "gate",
                "id": "prd-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "prd" },
                    { "type": "artifact_approved", "artifact": "prd" }
                ],
                "pass": {
                    "type": "task",
                    "id": "prototype",
                    "role": "coordinator",
                    "inputArtifacts": ["prd"],
                    "beforeDispatch": {
                        "inject": ["prd 已通过用户确认。请基于 prd 创建高保真 HTML 原型，展示页面布局、交互流程和状态反馈。"]
                    },
                    "afterComplete": {
                        "inject": ["原型设计完成。请检查 prototype 是否已写入并提交用户审批。"]
                    }
                },
                "fail": {
                    "goto": "clarify",
                    "maxRetries": 5,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "prototype-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "prototype" },
                    { "type": "artifact_approved", "artifact": "prototype" }
                ],
                "pass": {
                    "type": "task",
                    "id": "stories",
                    "role": "coordinator",
                    "inputArtifacts": ["prd", "prototype"],
                    "beforeDispatch": {
                        "inject": ["原型已通过用户确认。请基于 prd 和已确认的原型交互设计，撰写 user-stories（用户故事 + 验收标准）。"]
                    },
                    "afterComplete": {
                        "inject": ["用户故事撰写完成。请确认 user-stories 已写入。"]
                    }
                },
                "fail": {
                    "goto": "prototype",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "stories-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "user-stories" }
                ],
                "pass": {
                    "type": "task",
                    "id": "design",
                    "role": "architect",
                    "inputArtifacts": ["prd", "user-stories", "prototype"],
                    "beforeDispatch": {
                        "inject": ["需求阶段全部完成。请基于 prd、user-stories 和 prototype 进行技术设计，产出 tech-design（技术方案）。"]
                    },
                    "afterComplete": {
                        "inject": ["技术方案设计完成。请确认 tech-design 已写入并提交用户审批。"]
                    }
                },
                "fail": {
                    "goto": "stories",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "tech-design-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "tech-design" },
                    { "type": "artifact_approved", "artifact": "tech-design" }
                ],
                "pass": {
                    "type": "task",
                    "id": "design-detail",
                    "role": "architect",
                    "inputArtifacts": ["prd", "user-stories", "prototype", "tech-design"],
                    "beforeDispatch": {
                        "inject": ["tech-design 已通过用户确认。请基于已确认的技术方案，继续完成后续设计产出。"]
                    },
                    "afterComplete": {
                        "inject": ["API 设计和任务拆解完成。请确认 api-design 和 task-breakdown 已写入，task-breakdown 需提交用户审批。"]
                    }
                },
                "fail": {
                    "goto": "design",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "design-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "api-design" },
                    { "type": "artifact_exists", "artifact": "task-breakdown" },
                    { "type": "artifact_approved", "artifact": "task-breakdown" }
                ],
                "pass": {
                    "type": "loop",
                    "id": "develop-loop",
                    "maxIterations": 20,
                    "body": {
                        "type": "task",
                        "id": "develop-batch",
                        "role": "developer",
                        "inputArtifacts": ["tech-design", "api-design", "task-breakdown", "prd"],
                        "beforeDispatch": {
                            "inject": ["按 task-breakdown 中的顺序执行开发任务，每次完成 2 条任务后提交代码并汇报。\n\n首次迭代：直接开始前 2 条任务。\n后续迭代：先向用户简要汇报上批完成情况，等用户确认后再继续下 2 条任务。"]
                        },
                        "afterComplete": {
                            "inject": ["本批任务已完成。请检查 task-breakdown，判断是否所有任务都已完成：\n- 如果还有未完成的任务：继续下一轮迭代。\n- 如果所有任务已完成：调用 loop_done 结束开发循环。"]
                        }
                    }
                },
                "fail": {
                    "goto": "design-detail",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "task",
                "id": "test-plan",
                "role": "tester",
                "inputArtifacts": ["prd", "user-stories", "prototype", "api-design"],
                "beforeDispatch": {
                    "inject": ["开发完成。请基于 user-stories 验收标准编写测试计划，产出 test-plan。"]
                },
                "afterComplete": {
                    "inject": ["测试计划编写完成。请确认 test-plan 已写入并提交用户审批。"]
                }
            },
            {
                "type": "gate",
                "id": "test-plan-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "test-plan" },
                    { "type": "artifact_approved", "artifact": "test-plan" }
                ],
                "pass": {
                    "type": "task",
                    "id": "test-execute",
                    "role": "tester",
                    "inputArtifacts": ["test-plan", "api-design", "prototype", "code"],
                    "beforeDispatch": {
                        "inject": ["测试计划已通过用户确认。请按照 test-plan 执行测试，产出 test-report。"]
                    },
                    "afterComplete": {
                        "inject": ["测试执行完成。请确认 test-report 已写入并提交用户审批。"]
                    }
                },
                "fail": {
                    "goto": "test-plan",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "test-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "test-report" },
                    { "type": "artifact_approved", "artifact": "test-report" }
                ],
                "pass": {
                    "type": "task",
                    "id": "deliver",
                    "role": "coordinator",
                    "beforeDispatch": {
                        "inject": ["所有测试已通过用户确认，开发流程完成。请向用户做最终交付总结。"]
                    }
                },
                "fail": {
                    "goto": "develop-loop",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            }
        ]
    },
    "floatingNodes": [
        {
            "type": "task",
            "id": "escalate",
            "role": "coordinator",
            "beforeDispatch": {
                "inject": [
                    "升级处理：某个流程门控（gate）的重试次数已耗尽，流程无法继续。请检查当前工作流状态（project_status），识别失败的 gate 和对应的条件，与用户沟通决定下一步行动方案。"
                ]
            }
        }
    ],
    "artifacts": {
        "prd": {
            "name": "需求文档",
            "review": true,
            "steps": [
                {
                    "id": "requirements",
                    "name": "需求结构化",
                    "format": "json",
                    "description": "将用户需求整理为结构化 JSON：功能列表、优先级、约束条件"
                },
                {
                    "id": "completeness-check",
                    "name": "完整性校验",
                    "format": "json",
                    "description": "检查需求覆盖率、遗漏项、冲突项，输出校验报告"
                },
                {
                    "id": "draft",
                    "name": "PRD 文档草稿",
                    "format": "md",
                    "description": "基于结构化需求生成完整 PRD 文档"
                },
                {
                    "id": "final",
                    "name": "PRD 最终版",
                    "format": "md",
                    "description": "根据校验结果修订，产出最终 PRD"
                }
            ]
        },
        "user-stories": {
            "name": "用户故事 + 验收标准"
        },
        "prototype": {
            "name": "高保真原型",
            "format": "html",
            "review": true
        },
        "tech-design": {
            "name": "技术方案",
            "review": true,
            "steps": [
                {
                    "id": "analysis",
                    "name": "技术分析",
                    "format": "json",
                    "description": "分析现有代码结构、技术约束、可行方案，输出结构化分析报告"
                },
                {
                    "id": "research",
                    "name": "技术预研",
                    "format": "json",
                    "description": "三方对接/外部依赖的可行性验证、风险评估、替代方案"
                },
                {
                    "id": "draft",
                    "name": "技术方案草稿",
                    "format": "md",
                    "description": "基于分析和预研结果，生成完整技术方案文档（含技术选型、架构决策、风险评估）"
                },
                {
                    "id": "final",
                    "name": "技术方案最终版",
                    "format": "md",
                    "description": "修订并产出最终技术方案"
                }
            ]
        },
        "data-model": {
            "name": "数据模型设计"
        },
        "api-design": {
            "name": "API 设计",
            "description": "内部模块 API 设计：模块划分与职责、公共方法签名（参数、返回值、异常）、模块间依赖与调用关系、数据流转路径。如有对外 HTTP 接口需求，另见 api-contract。"
        },
        "api-contract": {
            "name": "对外接口契约",
            "description": "对外 HTTP 接口定义：路由、请求/响应格式、认证鉴权方案、错误码约定（仅前后端分离或需对外暴露接口的项目）"
        },
        "task-breakdown": {
            "name": "任务拆解",
            "review": true,
            "steps": [
                {
                    "id": "coarse",
                    "name": "粗粒度拆分",
                    "format": "json",
                    "description": "按功能模块拆分为主要任务块，标注预估工作量"
                },
                {
                    "id": "dependencies",
                    "name": "依赖分析",
                    "format": "json",
                    "description": "分析任务间依赖关系、确定执行顺序和并行可能性"
                },
                {
                    "id": "detailed",
                    "name": "细化任务",
                    "format": "md",
                    "description": "将粗粒度任务细化为可执行的开发任务"
                },
                {
                    "id": "final",
                    "name": "任务拆解最终版",
                    "format": "md",
                    "description": "整合依赖关系，产出最终任务拆解文档"
                }
            ]
        },
        "test-plan": {
            "name": "测试计划",
            "review": true
        },
        "test-report": {
            "name": "测试报告",
            "review": true
        },
        "code": {
            "name": "代码实现",
            "output": "{project}"
        }
    }
}
