{
    "name": "dev",
    "description": "软件开发流程",
    "version": "2.0.0",
    "author": "harmonia",
    "coordinator": "coordinator",
    "root": {
        "type": "sequence",
        "id": "main",
        "children": [
            {
                "type": "task",
                "id": "clarify",
                "role": "coordinator",
                "afterComplete": {
                    "inject": ["需求澄清完成。请检查 prd 和 user-stories 是否已写入，以及 prd 是否需要审批。"]
                }
            },
            {
                "type": "gate",
                "id": "prd-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "prd" },
                    { "type": "artifact_exists", "artifact": "user-stories" },
                    { "type": "artifact_approved", "artifact": "prd" }
                ],
                "pass": {
                    "type": "task",
                    "id": "design",
                    "role": "architect",
                    "beforeDispatch": {
                        "inject": ["请基于 prd 和 user-stories 进行技术设计。产出 tech-design 和 task-breakdown。"]
                    },
                    "afterComplete": {
                        "inject": ["设计阶段完成。请确认 tech-design 和 task-breakdown 已写入。"]
                    }
                },
                "fail": {
                    "goto": "clarify",
                    "maxRetries": 5,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "gate",
                "id": "design-gate",
                "conditions": [
                    { "type": "artifact_exists", "artifact": "tech-design" },
                    { "type": "artifact_exists", "artifact": "task-breakdown" }
                ],
                "pass": {
                    "type": "task",
                    "id": "develop",
                    "role": "developer",
                    "beforeDispatch": {
                        "inject": ["请基于 task-breakdown 和 tech-design 实现代码。"]
                    },
                    "afterComplete": {
                        "inject": ["开发阶段完成。代码已实现。"]
                    }
                },
                "fail": {
                    "goto": "design",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            },
            {
                "type": "task",
                "id": "test",
                "role": "tester",
                "beforeDispatch": {
                    "inject": ["请基于 prd、user-stories 编写测试计划并执行测试，产出 test-report。"]
                },
                "afterComplete": {
                    "inject": ["测试阶段完成。请检查 test-report 结果。"]
                }
            },
            {
                "type": "gate",
                "id": "test-gate",
                "conditions": [
                    {
                        "type": "artifact_field",
                        "artifact": "test-report",
                        "field": "result",
                        "operator": "eq",
                        "value": "pass"
                    }
                ],
                "pass": {
                    "type": "task",
                    "id": "deliver",
                    "role": "coordinator",
                    "beforeDispatch": {
                        "inject": ["所有测试通过。请进行最终交付验收，产出 retrospective。"]
                    }
                },
                "fail": {
                    "goto": "develop",
                    "maxRetries": 3,
                    "onExhausted": "escalate"
                }
            }
        ]
    },
    "floatingNodes": [
        {
            "type": "task",
            "id": "escalate",
            "role": "coordinator"
        }
    ],
    "artifacts": {
        "prd": {
            "name": "需求文档",
            "review": true,
            "steps": [
                {
                    "id": "requirements",
                    "name": "需求结构化",
                    "format": "json",
                    "description": "将用户需求整理为结构化 JSON：功能列表、优先级、约束条件"
                },
                {
                    "id": "completeness-check",
                    "name": "完整性校验",
                    "format": "json",
                    "description": "检查需求覆盖率、遗漏项、冲突项，输出校验报告"
                },
                {
                    "id": "draft",
                    "name": "PRD 文档草稿",
                    "format": "md",
                    "description": "基于结构化需求生成完整 PRD 文档"
                },
                {
                    "id": "final",
                    "name": "PRD 最终版",
                    "format": "md",
                    "description": "根据校验结果修订，产出最终 PRD"
                }
            ]
        },
        "user-stories": {
            "name": "用户故事 + 验收标准"
        },
        "fsd": {
            "name": "功能规格"
        },
        "prototype": {
            "name": "高保真原型",
            "format": "html",
            "review": true
        },
        "project-plan": {
            "name": "项目计划"
        },
        "tech-design": {
            "name": "技术方案",
            "steps": [
                {
                    "id": "analysis",
                    "name": "架构分析",
                    "format": "json",
                    "description": "分析现有代码结构、技术约束、可行方案，输出结构化分析报告"
                },
                {
                    "id": "api-contract",
                    "name": "API 契约定义",
                    "format": "json",
                    "description": "定义 API 端点、请求/响应格式、错误码，输出契约文档"
                },
                {
                    "id": "draft",
                    "name": "技术方案草稿",
                    "format": "md",
                    "description": "基于分析和契约生成完整技术方案文档"
                },
                {
                    "id": "final",
                    "name": "技术方案最终版",
                    "format": "md",
                    "description": "修订并产出最终技术方案"
                }
            ]
        },
        "data-model": {
            "name": "数据模型设计"
        },
        "api-design": {
            "name": "API 设计"
        },
        "task-breakdown": {
            "name": "任务拆解",
            "steps": [
                {
                    "id": "coarse",
                    "name": "粗粒度拆分",
                    "format": "json",
                    "description": "按功能模块拆分为主要任务块，标注预估工作量"
                },
                {
                    "id": "dependencies",
                    "name": "依赖分析",
                    "format": "json",
                    "description": "分析任务间依赖关系、确定执行顺序和并行可能性"
                },
                {
                    "id": "detailed",
                    "name": "细化任务",
                    "format": "md",
                    "description": "将粗粒度任务细化为可执行的开发任务"
                },
                {
                    "id": "final",
                    "name": "任务拆解最终版",
                    "format": "md",
                    "description": "整合依赖关系，产出最终任务拆解文档"
                }
            ]
        },
        "risk-assessment": {
            "name": "技术风险评估"
        },
        "test-plan": {
            "name": "测试计划"
        },
        "test-report": {
            "name": "测试报告"
        },
        "deploy": {
            "name": "部署文档"
        },
        "retrospective": {
            "name": "复盘记录"
        },
        "code": {
            "name": "代码实现",
            "external": true
        }
    }
}
