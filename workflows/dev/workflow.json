{
    "name": "dev",
    "description": "软件开发流程",
    "phases": [
        {
            "id": "clarify",
            "name": "需求澄清",
            "roles": ["pm"],
            "outputs": ["prd", "user-stories"],
            "description": "与用户沟通，明确需求范围、功能点、约束条件"
        },
        {
            "id": "design",
            "name": "方案设计",
            "roles": ["architect"],
            "inputs": ["prd", "user-stories"],
            "outputs": ["tech-design", "task-breakdown"],
            "description": "分析代码库，制定技术方案，拆解开发任务"
        },
        {
            "id": "develop",
            "name": "开发",
            "roles": ["developer"],
            "inputs": ["task-breakdown", "tech-design"],
            "outputs": ["code"],
            "description": "按任务拆解编码实现"
        },
        {
            "id": "test",
            "name": "测试",
            "roles": ["tester"],
            "inputs": ["code", "prd", "user-stories"],
            "outputs": ["test-report"],
            "description": "编写测试、执行测试、输出测试报告"
        },
        {
            "id": "deliver",
            "name": "交付验收",
            "roles": ["pm"],
            "inputs": ["test-report", "code"],
            "outputs": ["retrospective"],
            "description": "验收成果，确认需求满足，输出复盘记录"
        }
    ],
    "docs": {
        "prd": {
            "name": "需求文档",
            "scale": { "small": "lite", "medium": "full", "large": "full" },
            "review": true,
            "steps": [
                {
                    "id": "requirements",
                    "name": "需求结构化",
                    "format": "json",
                    "description": "将用户需求整理为结构化 JSON：功能列表、优先级、约束条件"
                },
                {
                    "id": "completeness-check",
                    "name": "完整性校验",
                    "format": "json",
                    "description": "检查需求覆盖率、遗漏项、冲突项，输出校验报告"
                },
                {
                    "id": "draft",
                    "name": "PRD 文档草稿",
                    "format": "md",
                    "description": "基于结构化需求生成完整 PRD 文档"
                },
                {
                    "id": "final",
                    "name": "PRD 最终版",
                    "format": "md",
                    "description": "根据校验结果修订，产出最终 PRD"
                }
            ]
        },
        "user-stories": {
            "name": "用户故事 + 验收标准",
            "scale": { "small": "full", "medium": "full", "large": "full" },
            "review": false
        },
        "fsd": {
            "name": "功能规格",
            "scale": { "small": "skip", "medium": "full", "large": "full" },
            "review": false
        },
        "prototype": {
            "name": "高保真原型",
            "format": "html",
            "scale": { "small": "skip", "medium": "full", "large": "full" },
            "review": true
        },
        "project-plan": {
            "name": "项目计划",
            "scale": { "small": "skip", "medium": "full", "large": "full" },
            "review": false
        },
        "tech-design": {
            "name": "技术方案",
            "scale": { "small": "lite", "medium": "full", "large": "full" },
            "review": false,
            "steps": [
                {
                    "id": "analysis",
                    "name": "架构分析",
                    "format": "json",
                    "description": "分析现有代码结构、技术约束、可行方案，输出结构化分析报告"
                },
                {
                    "id": "api-contract",
                    "name": "API 契约定义",
                    "format": "json",
                    "description": "定义 API 端点、请求/响应格式、错误码，输出契约文档"
                },
                {
                    "id": "draft",
                    "name": "技术方案草稿",
                    "format": "md",
                    "description": "基于分析和契约生成完整技术方案文档"
                },
                {
                    "id": "final",
                    "name": "技术方案最终版",
                    "format": "md",
                    "description": "修订并产出最终技术方案"
                }
            ]
        },
        "data-model": {
            "name": "数据模型设计",
            "scale": { "small": "skip", "medium": "optional", "large": "full" },
            "review": false
        },
        "api-design": {
            "name": "API 设计",
            "scale": { "small": "skip", "medium": "optional", "large": "full" },
            "review": false
        },
        "task-breakdown": {
            "name": "任务拆解",
            "scale": { "small": "full", "medium": "full", "large": "full" },
            "review": false,
            "steps": [
                {
                    "id": "coarse",
                    "name": "粗粒度拆分",
                    "format": "json",
                    "description": "按功能模块拆分为主要任务块，标注预估工作量"
                },
                {
                    "id": "dependencies",
                    "name": "依赖分析",
                    "format": "json",
                    "description": "分析任务间依赖关系、确定执行顺序和并行可能性"
                },
                {
                    "id": "detailed",
                    "name": "细化任务",
                    "format": "md",
                    "description": "将粗粒度任务细化为可执行的开发任务"
                },
                {
                    "id": "final",
                    "name": "任务拆解最终版",
                    "format": "md",
                    "description": "整合依赖关系，产出最终任务拆解文档"
                }
            ]
        },
        "risk-assessment": {
            "name": "技术风险评估",
            "scale": { "small": "skip", "medium": "optional", "large": "full" },
            "review": false
        },
        "test-plan": {
            "name": "测试计划",
            "scale": { "small": "skip", "medium": "full", "large": "full" },
            "review": false
        },
        "test-report": {
            "name": "测试报告",
            "scale": { "small": "lite", "medium": "full", "large": "full" },
            "review": false
        },
        "deploy": {
            "name": "部署文档",
            "scale": { "small": "skip", "medium": "optional", "large": "full" },
            "review": false
        },
        "retrospective": {
            "name": "复盘记录",
            "scale": { "small": "skip", "medium": "optional", "large": "full" },
            "review": false
        },
        "code": {
            "name": "代码实现",
            "external": true,
            "scale": { "small": "full", "medium": "full", "large": "full" },
            "review": false
        }
    },
    "scale_criteria": {
        "description": "PM 根据以下维度判断项目规模",
        "dimensions": {
            "feature_count": { "small": "1-3", "medium": "4-10", "large": "10+" },
            "frontend_backend_split": { "small": false, "medium": "maybe", "large": true },
            "data_persistence": { "small": "none_or_simple", "medium": "yes", "large": "complex" },
            "external_integrations": { "small": "none", "medium": "few", "large": "many" },
            "parallel_developers": { "small": 1, "medium": "1-2", "large": "3+" }
        }
    }
}
